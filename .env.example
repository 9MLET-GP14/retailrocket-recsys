# ─── Paths ────────────────────────────────────────────────
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
MODELS_PATH=models

# ─── MLflow ───────────────────────────────────────────────
# Servidor MLflow em container (padrão; suba com `make mlflow-up`):
MLFLOW_TRACKING_URI=http://localhost:6060
# Alternativa offline sem Docker (SQLite local):
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=retailrocket-recsys

# ─── DVC Remote ───────────────────────────────────────────
DVC_REMOTE_URL=s3://your-bucket/dvc-store   # ou caminho local

# ─── Kaggle (opcional) ────────────────────────────────────
# O dataset RetailRocket é público: o download via
# scripts/download_data.py funciona sem credenciais.
# Preencha apenas se o download anônimo falhar
# (credenciais em https://www.kaggle.com/settings -> API).
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# ─── Model Hyperparameters ────────────────────────────────
EMBEDDING_DIM=64
HIDDEN_DIMS=256,128,64
DROPOUT=0.3
LEARNING_RATE=0.001
BATCH_SIZE=512
MAX_EPOCHS=50
EARLY_STOPPING_PATIENCE=5
SEED=42

# ─── Evaluation ───────────────────────────────────────────
TOP_K=10
