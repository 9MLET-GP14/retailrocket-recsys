# ─── Paths ────────────────────────────────────────────────
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
MODELS_PATH=models

# ─── MLflow ───────────────────────────────────────────────
# Tracking local com SQLite (padrão, não requer servidor):
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Servidor remoto (use com docker-compose up mlflow):
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=retailrocket-recsys

# ─── DVC Remote ───────────────────────────────────────────
DVC_REMOTE_URL=s3://your-bucket/dvc-store   # ou caminho local

# ─── Model Hyperparameters ────────────────────────────────
EMBEDDING_DIM=64
HIDDEN_DIMS=256,128,64
DROPOUT=0.3
LEARNING_RATE=0.001
BATCH_SIZE=512
MAX_EPOCHS=50
EARLY_STOPPING_PATIENCE=5
SEED=42

# ─── Evaluation ───────────────────────────────────────────
TOP_K=10
